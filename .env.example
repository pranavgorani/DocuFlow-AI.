# DocuFlow AI Environment Configuration

# ==========================================
# BACKEND CONFIGURATION (.env in /backend)
# ==========================================
ENV="development" # development | staging | production | test
DEBUG=true
PORT=8000
API_V1_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database
# Default: zero-configuration local SQLite for instant local development & testing
DATABASE_URL="sqlite:///./docuflow.db"
# Production Supabase PostgreSQL:
# DATABASE_URL="postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Security & JWT Token Auth
SECRET_KEY="docuflow-ai-super-secret-production-grade-encryption-key-32b"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI & OCR Configuration
# Set your Gemini API Key below for live Gemini 2.5 Flash structured document extraction
GEMINI_API_KEY=""
AI_EXTRACTION_PROVIDER="mock" # Set 'gemini' for live Gemini API, or 'mock' for synthetic real estate demo
OCR_PROVIDER="mock"          # 'gemini' | 'tesseract' | 'mock'
DEMO_MODE=true

# Private Storage Vault
STORAGE_PROVIDER="local" # 'local' | 'supabase' | 's3'
LOCAL_STORAGE_VAULT_PATH="./vault"

# ==========================================
# FRONTEND CONFIGURATION (.env.local in /frontend)
# ==========================================
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api/v1"
NEXT_PUBLIC_APP_NAME="DocuFlow AI"
NEXT_PUBLIC_DEMO_MODE=true
